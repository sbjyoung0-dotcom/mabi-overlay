{
  "name": "mabi-overlay",
  "version": "0.3.0",
  "private": true,
  "description": "Mabinogi Mobile altering/gathering overlay (uses official MabinogiMobile_CLI)",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "build": "electron-builder --win nsis",
    "build:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "local.mabi-overlay",
    "productName": "mabi-overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**",
      "renderer/**",
      "shared/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "mabi-overlay",
      "artifactName": "mabi-overlay-setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
